# Gmail account that SENDS the breakout alerts.
EMAIL_USER=your_gmail@gmail.com

# A Google APP PASSWORD — not your normal Gmail password.
# Google Account -> Security -> 2-Step Verification -> App passwords
# It is exactly 16 characters. Anything else will fail with
# "Invalid login: 535-5.7.8 Username and Password not accepted".
EMAIL_PASS=your16charapppass

# Where breakout alerts are delivered (can be the same address as EMAIL_USER).
ALERT_EMAIL=you@example.com

# Optional — the server defaults to 3001.
# PORT=3001
